{
  "$schema": "./config.schema.json",
  "$comment": "Personal overrides live in ~/.laconia/config.json. Invalid configuration becomes advisory with browser restrictions disabled.",
  "mode": "advisory",
  "blockRules": [
    "em-dash",
    "inline-header-bullet",
    "emoji"
  ],
  "circuitBreaker": {
    "maxBlocksPerSession": 2
  },
  "lint": {
    "wordBudget": 150,
    "wordBudgetDepth": 600,
    "maxBoldSpans": 2,
    "boldPer100Words": 1.2,
    "headerFreeUnder": 400,
    "disabledRules": [],
    "format": "chat"
  },
  "browserFirst": {
    "enabled": false,
    "denyWebFetch": true,
    "denyWebSearch": true
  },
  "ledger": {
    "enabled": true
  }
}
